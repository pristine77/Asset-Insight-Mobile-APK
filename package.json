{
  "name": "my-expo-app",
  "version": "1.0.0",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start",
    "test": "jest --runInBand",
    "prebuild": "expo prebuild",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web",
    "ios-build": "eas build -p ios --profile production --auto-submit",
    "android-build": "eas build -p android --profile production",
    "run": "npx expo prebuild --clean && npx expo run:android",
    "dev": "npx expo prebuild && npx expo run:android",
    "expo": "npx expo run:android"
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-community/slider": "^5.1.1",
    "@shopify/react-native-skia": "^2.6.2",
    "axios": "^1.13.2",
    "babel-preset-expo": "~54.0.9",
    "expo": "~54.0.30",
    "expo-apple-authentication": "~8.0.8",
    "expo-application": "~7.0.8",
    "expo-av": "~16.0.7",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-intent-launcher": "~13.0.8",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-localization": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-mail-composer": "~15.0.8",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "~0.32.16",
    "expo-screen-orientation": "~9.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "lightningcss": "^1.30.1",
    "nativewind": "latest",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-nitro-image": "^0.13.1",
    "react-native-nitro-modules": "^0.35.4",
    "react-native-purchases": "^9.4.2",
    "react-native-purchases-ui": "^9.4.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "5.6.1",
    "react-native-svg": "15.12.1",
    "react-native-vision-camera": "^5.0.1",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-native-worklets-core": "^1.6.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.1.12",
    "eslint": "^9.25.1",
    "eslint-config-expo": "10.0.0",
    "eslint-config-prettier": "^10.1.2",
    "jest-expo": "~54.0.17",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.0",
    "typescript": "5.9.2"
  },
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": ["/node_modules/", "/android/", "/ios/"]
  }
}
